# Server-only settings. Never put keys in VITE_* variables.
GMS_KEY=
LLM_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1/
LLM_MODEL=gpt-6.1-sol
# Empty override uses GMS_KEY. Personal provider requires an explicit URL and key.
LLM_API_KEY=
# GMS embeddings: confirmed by the user on 2026-10-21.
EMBEDDING_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1/
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_API_KEY=
API_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=256
CHROMA_PATH=data/chroma
COMMUNITY_DB_PATH=data/community.sqlite3
# Optional server-only moderation key (32+ characters). Empty disables deletion.
COMMUNITY_ADMIN_KEY=
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EXTERNAL_TOP_K=4
# 외부 후보 검색: 키워드 후보 수, 선별 후 새로 쓸 최대 문서 수
CANDIDATE_LIMIT=8
MAX_SELECTED_DOCUMENTS=4
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Do not export prompts or practice records to tracing services.
LANGSMITH_TRACING=false
